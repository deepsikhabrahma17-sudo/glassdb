# The Phase 3 done-when file: 50+ statements covering every statement kind,
# with two restarts. After each restart the database is reopened from the
# file on disk, and the same queries must give the same answers.

statement ok
CREATE TABLE users (id INT PRIMARY KEY, name TEXT, score REAL, active BOOL)

statement ok
CREATE TABLE notes (body TEXT, stars INT)

query
INSERT INTO users VALUES (1, 'ada', 91.5, TRUE), (2, 'bob', 72, FALSE), (3, 'cy', NULL, TRUE)
----
inserted 3 rows

# Columns left out are NULL.
query
INSERT INTO users (id, name) VALUES (4, 'dee')
----
inserted 1 row

# No id given: the next one after the largest (4) is used.
query
INSERT INTO users (name, active) VALUES ('eve', TRUE)
----
inserted 1 row

query
INSERT INTO notes VALUES ('first', 3), ('second', 5), ('it''s third', NULL)
----
inserted 3 rows

query
SELECT * FROM users ORDER BY id
----
id | name | score | active
1 | ada | 91.5 | true
2 | bob | 72.0 | false
3 | cy | NULL | true
4 | dee | NULL | NULL
5 | eve | NULL | true

query
SELECT body, stars FROM notes
----
body | stars
first | 3
second | 5
it's third | NULL

query
SELECT name FROM users WHERE active ORDER BY name DESC
----
name
eve
cy
ada

query
SELECT name, score FROM users WHERE score > 80 OR score IS NULL ORDER BY id
----
name | score
ada | 91.5
cy | NULL
dee | NULL
eve | NULL

query
SELECT id, score * 2 AS double FROM users WHERE score IS NOT NULL ORDER BY double DESC
----
id | double
1 | 183.0
2 | 144.0

query
SELECT name FROM users ORDER BY id LIMIT 2
----
name
ada
bob

query
SELECT name FROM users ORDER BY id LIMIT 2 OFFSET 3
----
name
dee
eve

query
SELECT 1 + 2 * 3, 7 / 2, 7 % 3, 7.0 / 2, -4
----
1 + 2 * 3 | 7 / 2 | 7 % 3 | 7.0 / 2 | -4
7 | 3 | 1 | 3.5 | -4

query
SELECT name, active IS NULL AS unknown FROM users WHERE id >= 3 ORDER BY id
----
name | unknown
cy | false
dee | true
eve | false

restart

# Same answers, now read back from disk.
query
SELECT * FROM users ORDER BY id
----
id | name | score | active
1 | ada | 91.5 | true
2 | bob | 72.0 | false
3 | cy | NULL | true
4 | dee | NULL | NULL
5 | eve | NULL | true

query
SELECT body, stars FROM notes
----
body | stars
first | 3
second | 5
it's third | NULL

query
SELECT name FROM users WHERE active ORDER BY name DESC
----
name
eve
cy
ada

query
SELECT name, score FROM users WHERE score > 80 OR score IS NULL ORDER BY id
----
name | score
ada | 91.5
cy | NULL
dee | NULL
eve | NULL

query
UPDATE users SET score = score + 1 WHERE score IS NOT NULL
----
updated 2 rows

query
UPDATE users SET active = FALSE, score = 50 WHERE name = 'dee'
----
updated 1 row

query
SELECT id, name, score, active FROM users ORDER BY id
----
id | name | score | active
1 | ada | 92.5 | true
2 | bob | 73.0 | false
3 | cy | NULL | true
4 | dee | 50.0 | false
5 | eve | NULL | true

# Changing the primary key moves the row.
query
UPDATE users SET id = id + 10 WHERE id <= 2
----
updated 2 rows

query
SELECT id, name FROM users ORDER BY id
----
id | name
3 | cy
4 | dee
5 | eve
11 | ada
12 | bob

statement error duplicate primary key: users.id = 3
UPDATE users SET id = 3 WHERE name = 'eve'

statement error duplicate primary key: users.id = 11
INSERT INTO users (id, name) VALUES (11, 'again')

query
DELETE FROM users WHERE active = FALSE
----
deleted 2 rows

query
SELECT id, name FROM users ORDER BY id
----
id | name
3 | cy
5 | eve
11 | ada

query
INSERT INTO users (name) VALUES ('fay')
----
inserted 1 row

query
SELECT id, name FROM users WHERE name = 'fay'
----
id | name
12 | fay

query
DELETE FROM notes WHERE stars IS NULL
----
deleted 1 row

query
SELECT body, stars FROM notes
----
body | stars
first | 3
second | 5

