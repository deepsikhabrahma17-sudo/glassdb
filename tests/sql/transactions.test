# BEGIN, COMMIT and ROLLBACK, before and after restarts.

statement ok
CREATE TABLE t (id INT PRIMARY KEY, name TEXT)

statement ok
INSERT INTO t VALUES (1, 'kept')

# ROLLBACK undoes everything, and a transaction sees its own changes.

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (2, 'gone')

statement ok
UPDATE t SET name = 'changed' WHERE id = 1

query
SELECT * FROM t
----
id | name
1 | changed
2 | gone

statement ok
ROLLBACK

query
SELECT * FROM t
----
id | name
1 | kept

restart

query
SELECT * FROM t
----
id | name
1 | kept

# COMMIT keeps it all, including across a restart.

statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO t VALUES (2, 'two')

statement ok
DELETE FROM t WHERE id = 1

statement ok
COMMIT

restart

query
SELECT * FROM t
----
id | name
2 | two

# Table changes are part of the transaction.

statement ok
BEGIN

statement ok
CREATE TABLE ghost (a INT)

statement ok
DROP TABLE t

statement error no such table
SELECT * FROM t

statement ok
ROLLBACK

statement error no such table
SELECT * FROM ghost

query
SELECT * FROM t
----
id | name
2 | two

# A transaction left open at a restart is rolled back.

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (3, 'unfinished')

restart

query
SELECT * FROM t
----
id | name
2 | two

# A rejected statement changes nothing and leaves the transaction open.

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (3, 'three')

statement error duplicate primary key
INSERT INTO t VALUES (3, 'again')

statement error no such column
SELECT missing FROM t

statement ok
INSERT INTO t VALUES (4, 'four')

statement ok
COMMIT

query
SELECT id FROM t ORDER BY id
----
id
2
3
4

# These only make sense in the right order.

statement error no transaction
COMMIT

statement error no transaction
ROLLBACK

statement ok
BEGIN

statement error already in a transaction
BEGIN

statement ok
ROLLBACK

# The words stay usable as names.

statement ok
CREATE TABLE begin (commit INT, rollback TEXT)

statement ok
INSERT INTO begin VALUES (1, 'fine')

restart

query
SELECT commit, rollback FROM begin
----
commit | rollback
1 | fine
