statement error latest is 8
SELECT * FROM accounts AS OF TXN 9

statement error no table nothing at txn 1
SELECT * FROM nothing AS OF TXN 1

statement error no such table
SELECT * FROM nothing HISTORY

statement error no such column
SELECT missing FROM accounts AS OF TXN 8

statement error expected
SELECT * FROM accounts AS OF

statement error bad timestamp
